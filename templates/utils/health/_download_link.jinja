{# Download button for a single health report. #}
{# Rendered in the report header, and out-of-band by the content partial when a running report finishes. #}
{% if report.status != 'running' %}
<a href="/utils/health/report/{{ report.id }}/download"
   class="btn-primary px-4 py-2 inline-flex items-center gap-2"
   hx-boost="false"
   title="Download this report as a JSON file">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
    </svg>
    Download
</a>
{% endif %}
